{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Open Lobotomy private-repository Renovate policy: keep all dependency work in one rolling PR for manual review.",
  "extends": ["./default"],
  "automerge": false,
  "platformAutomerge": false,
  "prConcurrentLimit": 1,
  "branchConcurrentLimit": 1,
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "vulnerabilityAlerts": {
    "automerge": false,
    "minimumReleaseAge": "3 days",
    "groupName": "All dependency updates",
    "groupSlug": "all-dependency-updates"
  },
  "packageRules": [
    {
      "description": "Private repositories use one rolling dependency PR and always require a human merge.",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["major", "minor", "patch", "pin", "pinDigest", "digest", "rollback", "bump"],
      "groupName": "All dependency updates",
      "groupSlug": "all-dependency-updates",
      "automerge": false,
      "recreateWhen": "always"
    },
    {
      "description": "Replacement updates remain manual; Renovate does not group replacement updates.",
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["replacement"],
      "groupName": null,
      "groupSlug": null,
      "automerge": false,
      "recreateWhen": "always"
    },
    {
      "description": "Keep any update without a release timestamp in the same manual rolling PR.",
      "matchPackageNames": ["*"],
      "matchJsonata": ["$not($exists(releaseTimestamp)) or $not($exists(newVersionAgeInDays))"],
      "groupName": "All dependency updates",
      "groupSlug": "all-dependency-updates",
      "automerge": false,
      "recreateWhen": "always"
    }
  ]
}
